@model Phoenix.Models.PartenerModel

@{
    ViewData["Title"] = "Adaugă Partener";
}

<h2>Adaugă Partener</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Denumire" class="form-label"></label>
        <input asp-for="Denumire" class="form-control" />
        <span asp-validation-for="Denumire" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Salvează</button>
    <a asp-action="Index" class="btn btn-secondary">Renunță</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
